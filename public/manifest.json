{
  "short_name": "clv-add-effort-point",
  "name": "ADD EFFORT POINT (CLV)",
  "version": "0.2.2",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": [ "dist/index.1fc7f4f6.css",
              "dist/index.4eeece91.css"],
      "js": ["dist/index.6099912e.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "scripting", "tabs", "activeTab"],
  "host_permissions": [
    "http://nguyennamserver.local:3000/*"
  ],
  "web_accessible_resources": [{
    "resources": ["*.js", "*.css"],
    "matches": ["http://nguyennamserver.local:3000/*"]
  }],
  "icons": {}
}
